{
  "name": "omp-docs",
  "version": "0.13.1",
  "private": true,
  "description": "User, team, administrator, operator and server-author documentation for Open MCP Portal, the self-hosted portal to a company's MCP servers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-names.mjs",
    "check:links": "node scripts/check-links.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "serve out",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "brand": "node scripts/brand-css.mjs",
    "logo": "node scripts/sync-logo.mjs",
    "screenshots": "node scripts/import-screenshots.mjs",
    "screenshots:check": "node scripts/import-screenshots.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.8",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
